# Debian slim: skia-canvas (@loskir/styled-qr-code-node) trae prebuilds glibc.
FROM node:20-bookworm-slim AS base
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app

FROM base AS deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY patches ./patches/
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json ./apps/api/
RUN pnpm install --frozen-lockfile || pnpm install

FROM deps AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY . .
RUN pnpm --filter @mali-one/shared build
RUN pnpm --filter @mali-one/api prisma:generate
RUN pnpm --filter @mali-one/api build

FROM node:24-bookworm-slim AS finance-tools
WORKDIR /opt/finance
COPY scripts/finance-runtime/package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY scripts/finance-runtime/niubiz-login.cjs ./
COPY scripts/finance-runtime/mercadopago-credentials.cjs ./

FROM node:20-bookworm-slim AS runner
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    ca-certificates \
    fontconfig \
    inkscape \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app
ENV NODE_ENV=production
COPY --from=finance-tools /usr/local/bin/node /opt/finance/node
COPY --from=finance-tools /opt/finance /opt/finance
ENV FINANCE_RUNTIME_NODE=/opt/finance/node
ENV NIUBIZ_LOGIN_SCRIPT=/opt/finance/niubiz-login.cjs
ENV MERCADOPAGO_CREDENTIALS_SCRIPT=/opt/finance/mercadopago-credentials.cjs
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/finance/browsers
RUN /opt/finance/node /opt/finance/node_modules/playwright/cli.js install --with-deps chromium

COPY --from=builder /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=builder /app/packages/shared ./packages/shared
COPY --from=builder /app/apps/api/package.json ./apps/api/
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules

COPY infra/docker/entrypoint-api.sh /entrypoint-api.sh
RUN chmod +x /entrypoint-api.sh

WORKDIR /app/apps/api
EXPOSE 3000
CMD ["sh", "/entrypoint-api.sh"]
