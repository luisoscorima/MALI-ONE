generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  operator
}

enum AppModule {
  links
  workspace_users
  s3_manager
  password_vault
  widget_educacion
  widget_biblioteca
  widget_museo
  widget_pam
  screen_cast
  bsale_reports
  mailing
  malichimp
  newsletters
  landings
  crm_pam
  crm_educacion
  catalog_educacion
  portfolio
  files
  treasury
}

enum TreasuryProvider {
  bcp
  interbank
  niubiz_sales
  diners
  expressnet
  mercadopago
}

enum TreasuryTargetKind {
  bank_account
  merchant
}

enum TreasuryCurrency {
  PEN
  USD
}

/// Portal access. Credentials stay in Vaultwarden; vaultItemId is only a pointer.
model TreasurySource {
  id                  String                @id @default(cuid())
  provider            TreasuryProvider
  name                String                @db.VarChar(120)
  legalEntity         String                @db.VarChar(160)
  /// Vaultwarden item UUID for this portal login. Not a secret.
  vaultItemId         String?               @db.VarChar(36)
  active              Boolean               @default(true)
  syncIntervalMinutes Int                   @default(60)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  targets             TreasuryTarget[]
  accessGrants        TreasuryAccessGrant[]
  mercadoPagoPayments MercadoPagoPayment[]
  mercadoPagoSync     MercadoPagoSyncState?

  @@unique([provider, name])
}

model MercadoPagoSyncState {
  sourceId   String         @id
  source     TreasurySource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  runId      String?
  status     String         @default("idle")
  startedAt  DateTime?
  finishedAt DateTime?
  leaseUntil DateTime?
  fromDate   String?
  toDate     String?
  errorCode  String?
  rowCount   Int            @default(0)
}

model MercadoPagoPayment {
  id                String           @id @default(cuid())
  sourceId          String
  source            TreasurySource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  paymentId         String           @db.VarChar(64)
  merchantOrderId   String?          @db.VarChar(64)
  externalReference String?          @db.VarChar(160)
  description       String?          @db.VarChar(300)
  status            String           @db.VarChar(40)
  statusDetail      String?          @db.VarChar(80)
  currency          TreasuryCurrency
  grossAmount       Decimal          @db.Decimal(18, 2)
  netAmount         Decimal?         @db.Decimal(18, 2)
  feeAmount         Decimal?         @db.Decimal(18, 2)
  paymentMethodId   String?          @db.VarChar(80)
  paymentTypeId     String?          @db.VarChar(40)
  issuerName        String?          @db.VarChar(120)
  cardLastDigits    String?          @db.VarChar(8)
  installments      Int?
  payerName         String?          @db.VarChar(250)
  payerEmail        String?          @db.VarChar(250)
  createdAtMp       DateTime
  approvedAt        DateTime?
  releasedAt        DateTime?
  lastUpdatedAtMp   DateTime
  /// Sanitized portal sale. Card numbers and payer identity documents are removed.
  payload           Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([sourceId, paymentId])
  @@index([sourceId, createdAtMp, id])
  @@index([sourceId, status])
}

model TreasuryTarget {
  id              String                @id @default(cuid())
  sourceId        String
  source          TreasurySource        @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  kind            TreasuryTargetKind
  /// MALI ONE alias shown in UI and filters.
  name            String                @db.VarChar(120)
  /// External portal code (Niubiz merchant id, bank account number). Immutable after create.
  reference       String                @db.VarChar(64)
  /// Name as shown in the portal (e.g. CURSOSDELMALI).
  externalName    String?               @db.VarChar(200)
  /// Required for bank_account; null for merchant (currency lives on each payment).
  currency        TreasuryCurrency?
  active          Boolean               @default(true)
  /// Niubiz only: at most one target per source feeds the PagoEfectivo CIP tab.
  paycashEnabled  Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  payments        TreasuryPayment[]
  accessGrants    TreasuryAccessGrant[]

  @@unique([sourceId, reference])
  @@index([sourceId, active])
}

/// Future ACL: user may see a whole source (targetId null) or one target. Not enforced yet.
model TreasuryAccessGrant {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId  String
  source    TreasurySource  @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  targetId  String?
  target    TreasuryTarget? @relation(fields: [targetId], references: [id], onDelete: Restrict)
  createdAt DateTime        @default(now())

  @@index([userId])
  @@index([sourceId])
}

model NiubizSyncState {
  id         String    @id
  runId      String?
  status     String    @default("idle")
  startedAt  DateTime?
  finishedAt DateTime?
  leaseUntil DateTime?
  fromDate   String?
  toDate     String?
  errorCode  String?
  results    Json      @default("[]")
}

/// PagoEfectivo operations shown inside Niubiz Comercio, not the separate PagoEfectivo API source.
model NiubizPayCashPayment {
  id            String           @id @default(cuid())
  merchantCode  String           @db.VarChar(9)
  cip           String           @db.VarChar(80)
  customerEmail String?          @db.VarChar(250)
  currency      TreasuryCurrency
  amount        Decimal          @db.Decimal(18, 2)
  brand         String           @db.VarChar(80)
  purchasedAt   DateTime
  paidAt        DateTime?
  status        String           @db.VarChar(40)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([merchantCode, cip])
  @@index([merchantCode, purchasedAt, id])
  @@index([merchantCode, status])
}

model NiubizPayCashSyncState {
  id                     String    @id
  runId                  String?
  status                 String    @default("idle")
  startedAt              DateTime?
  finishedAt             DateTime?
  leaseUntil             DateTime?
  errorCode              String?
  rowCount               Int       @default(0)
  createdCount           Int       @default(0)
  updatedCount           Int       @default(0)
  lastSuccessfulAt       DateTime?
  lastSuccessfulRowCount Int?
}

model TreasuryPaymentImport {
  id           String            @id @default(cuid())
  provider     TreasuryProvider
  origin       String            @db.VarChar(32)
  checksum     String            @db.VarChar(64)
  rowCount     Int
  createdCount Int
  updatedCount Int
  actorId      String
  createdAt    DateTime          @default(now())
  payments     TreasuryPayment[]

  @@index([createdAt])
}

model TreasuryPayment {
  id              String                @id @default(cuid())
  provider        TreasuryProvider
  targetId        String
  target          TreasuryTarget        @relation(fields: [targetId], references: [id], onDelete: Restrict)
  /// Denormalized portal code for exports and filters.
  merchantCode    String                @db.VarChar(64)
  merchantName    String                @db.VarChar(200)
  transactionCode String                @db.VarChar(100)
  orderNumber     String                @db.VarChar(100)
  customerName    String                @db.VarChar(250)
  customerEmail   String?               @db.VarChar(250)
  cardBrand       String?               @db.VarChar(80)
  cardType        String?               @db.VarChar(80)
  cardLastDigits  String?               @db.VarChar(8)
  wallet          String?               @db.VarChar(40)
  currency        TreasuryCurrency
  amount          Decimal               @db.Decimal(18, 2)
  status          String                @db.VarChar(80)
  transactedAt    DateTime
  settledOn       DateTime?             @db.Date
  /// Sanitized portal sale. Card numbers and payer identity documents are removed. Excel imports leave it untouched.
  payload         Json?
  lastImportId    String
  lastImport      TreasuryPaymentImport @relation(fields: [lastImportId], references: [id], onDelete: Restrict)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([targetId, transactionCode])
  @@index([transactedAt, id])
  @@index([merchantCode, status])
  @@index([provider, merchantCode])
}

enum TodoPriority {
  low
  medium
  high
  urgent
}

enum TodoEffort {
  xs
  s
  m
  l
  xl
}

enum PortfolioArea {
  infraestructura
  aplicaciones
  datos
  seguridad
  contenidos
  otros
}

enum PortfolioImpact {
  low
  medium
  high
}

enum PortfolioProjectType {
  estrategico
  tactico
  operativo
  mejora
  migracion
  otro
}

enum TodoOrigin {
  internal
  request
  incident
}

enum OperationalServiceStatus {
  up
  degraded
  down
  maintenance
}

enum ScreenCastMediaType {
  image
  video
  gif
}

enum ScreenCastOrientation {
  LANDSCAPE
  PORTRAIT
  PORTRAIT_FLIPPED
}

enum PamEmailStatus {
  PENDIENTE
  ENVIADO
  ERROR_DATOS
  ERROR_TEMP
}

enum PamMpStatus {
  pending
  in_process
  approved
  authorized
  rejected
  cancelled
  refunded
  charged_back
}

enum LinkType {
  URL
  FILE
  WHATSAPP
}

model User {
  id                  String                @id @default(cuid())
  googleId            String                @unique
  email               String                @unique
  name                String
  picture             String?
  role                UserRole              @default(operator)
  qrDefaultStyle      Json?
  accentTheme         String?
  createdAt           DateTime              @default(now())
  shortLinks          ShortLink[]
  auditLogs           AdminAuditLog[]       @relation("ActorAuditLogs")
  moduleAccess        UserModuleAccess[]
  newsletters         Newsletter[]
  landingsCreated     LandingPage[]         @relation("LandingCreatedBy")
  landingsUpdated     LandingPage[]         @relation("LandingUpdatedBy")
  emailCampaigns      EmailCampaign[]
  emailSenders        EmailSender[]
  todoItems           TodoItem[]
  portfolioProjects   PortfolioProject[]
  operationalServices OperationalService[]
  treasuryAccess      TreasuryAccessGrant[]
}

model UserModuleAccess {
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  module AppModule

  @@id([userId, module])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actor       User     @relation("ActorAuditLogs", fields: [actorId], references: [id])
  actorEmail  String
  action      String
  targetEmail String?
  payload     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model ShortLink {
  id                String                    @id @default(cuid())
  slug              String                    @unique
  targetUrl         String
  type              LinkType                  @default(URL)
  s3Key             String?
  fileName          String?
  mimeType          String?
  qrStyle           Json?
  qrLogoKey         String?
  createdById       String
  createdBy         User                      @relation(fields: [createdById], references: [id])
  createdAt         DateTime                  @default(now())
  archivedAt        DateTime?
  clickCount        Int                       @default(0)
  tags              String[]                  @default([])
  clicks            LinkClick[]
  catalogCursoId    String?
  catalogCurso      EducacionCatalogCurso?    @relation(fields: [catalogCursoId], references: [id], onDelete: SetNull)
  catalogProgramaId String?
  catalogPrograma   EducacionCatalogPrograma? @relation(fields: [catalogProgramaId], references: [id], onDelete: SetNull)
  catalogSedeId     String?
  catalogSede       EducacionCatalogSede?     @relation(fields: [catalogSedeId], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([createdById, archivedAt])
  @@index([catalogCursoId])
  @@index([catalogProgramaId])
  @@index([catalogSedeId])
  @@index([tags], type: Gin)
}

model EducacionCatalogArea {
  id           String                  @id @default(cuid())
  slug         String                  @unique
  nombre       String
  /// Null = área (Cursos de Arte, Extensión Profesional). Con padre = línea.
  parentId     String?
  parent       EducacionCatalogArea?   @relation("CatalogAreaLinea", fields: [parentId], references: [id], onDelete: Restrict)
  children     EducacionCatalogArea[]  @relation("CatalogAreaLinea")
  /// educacion_ca | educacion_ep. Solo en el área. La línea hereda la de su padre.
  whatsappArea String?
  activo       Boolean                 @default(true)
  sortOrder    Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  cursos       EducacionCatalogCurso[]

  @@index([parentId])
}

model EducacionCatalogCurso {
  id        String                          @id @default(cuid())
  nombre    String
  precio    Decimal?                        @db.Decimal(10, 2)
  descuento String?
  horario   String?
  activo    Boolean                         @default(true)
  sortOrder Int                             @default(0)
  areaId    String?
  area      EducacionCatalogArea?           @relation(fields: [areaId], references: [id], onDelete: Restrict)
  createdAt DateTime                        @default(now())
  updatedAt DateTime                        @updatedAt
  links     ShortLink[]
  programas EducacionCatalogProgramaCurso[]

  @@index([areaId])
}

model EducacionCatalogPrograma {
  id        String                          @id @default(cuid())
  nombre    String
  precio    Decimal?                        @db.Decimal(10, 2)
  descuento String?
  horario   String?
  activo    Boolean                         @default(true)
  sortOrder Int                             @default(0)
  createdAt DateTime                        @default(now())
  updatedAt DateTime                        @updatedAt
  links     ShortLink[]
  cursos    EducacionCatalogProgramaCurso[]
}

model EducacionCatalogProgramaCurso {
  programaId String
  cursoId    String
  sortOrder  Int                      @default(0)
  programa   EducacionCatalogPrograma @relation(fields: [programaId], references: [id], onDelete: Cascade)
  curso      EducacionCatalogCurso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@id([programaId, cursoId])
  @@index([cursoId])
}

model EducacionCatalogSede {
  id             String             @id @default(cuid())
  slug           String             @unique
  nombre         String
  nombreMapa     String?
  nombreSelector String?
  direccion      String?
  brochureUrl    String?
  icon           String             @default("location_on")
  lat            Float?
  lng            Float?
  horarioHtml    String?            @db.Text
  districtId     String?
  district       EducacionDistrict? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  showOnSelector Boolean            @default(true)
  showOnMap      Boolean            @default(false)
  activo         Boolean            @default(true)
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  links          ShortLink[]

  @@index([districtId])
}

model LinkClick {
  id         String    @id @default(cuid())
  linkId     String
  link       ShortLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  clickedAt  DateTime  @default(now())
  userAgent  String?
  deviceType String
  os         String?
  browser    String?

  @@index([linkId, clickedAt])
  @@index([linkId, deviceType])
}

model EducacionWidgetSettings {
  id               String   @id @default("default")
  whatsapp         String
  telefono         String
  email            String
  emailVirtual     String
  soporteVirtual   String
  imageRectangulo  String
  imageWhatsapp    String
  imageCirculo     String
  imageCorreo      String
  imageMarker      String
  mapsApiKey       String?
  googleCalendarId String?
  updatedAt        DateTime @updatedAt
}

model EducacionDistrict {
  id           String                 @id @default(cuid())
  name         String
  slug         String                 @unique
  brochureUrl  String?
  sortOrder    Int                    @default(0)
