}

/// Catálogo de medios de pago (editable en CRM PAM). Solo Mercado Pago es sistema/default del widget.
model PamPaymentMethod {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  active    Boolean  @default(true)
  /// No se puede borrar (p. ej. mercado_pago).
  system    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model PamRegistration {
  /// Ledger de pago/membresía (MP, welcome, expiry). La persona vive en WhatsApp CRM.
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now())
  nombres          String
  apellidos        String
  dni              String
  celular          String
  correo           String
  direccion        String?
  ciudad           String?
  distrito         String?
  genero           String?
  fechaNacimiento  String?
  comoTeEnteraste  String?
  plan             String
  frecuencia       String
  checkoutUrl      String?
  /// Slug de PamPaymentMethod (default mercado_pago en widget).
  paymentMethod    String         @default("mercado_pago")
  aceptaPrivacidad Boolean
  mpStatus         PamMpStatus?
  welcomeEmail     PamEmailStatus @default(PENDIENTE)
  expiryNotice     PamEmailStatus @default(PENDIENTE)
  expiryDate       DateTime?

  @@index([correo])
  @@index([mpStatus])
  @@index([celular])
  @@index([paymentMethod])
}

/// Lead del widget «Conversemos» (Educación). Persona canónica en WhatsApp CRM.
model EducacionLead {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  nombres        String
  apellidos      String
  dni            String?
  celular        String
  email          String?
  optInMarketing Boolean  @default(false)
  acceptPrivacy  Boolean
  courseSlug     String?
  courseTitle    String?
  pageUrl        String?
  captureSource  String   @default("wordpress_widget")
  referrer       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  gclid          String?
  fbclid         String?
  /// Área WhatsApp: educacion_ep (Extensión Profesional) | educacion_ca (Cursos de Arte)
  whatsappArea   String   @default("educacion_ep")
  fuente         String   @default("Web MALI Educación")
  /// Identificador técnico del origen (widget, import, etc.)
  source         String   @default("educacion_lead_widget")
  /// pending | ok | error | skipped
  waStatus       String   @default("pending")
  waError        String?
  /// pending | ok | error | skipped | disabled
  sheetStatus    String   @default("pending")
  sheetError     String?

  @@index([celular])
  @@index([email])
  @@index([createdAt])
  @@index([whatsappArea])
  @@index([captureSource])
  @@index([utmCampaign])
}

/// Persona comercial nativa ONE (piloto Prospectia / cutover parcial).
model EducacionPerson {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// Teléfono principal E.164 (+51…)
  phone         String?
  /// Teléfonos adicionales E.164 (JSON string[])
  phones        Json?
  email         String?
  name          String?
  lastName      String?
  waContactId   Int?
  /// Contact id Prospectia/Chatwoot (si aplica)
  prospectiaContactId String?
  opportunities EducacionOpportunity[]

  @@index([phone])
  @@index([email])
  @@index([waContactId])
  @@index([prospectiaContactId])
}

/// Oportunidad comercial nativa ONE. Canal prospectia = maestro ONE (piloto).
model EducacionOpportunity {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  personId          String
  person            EducacionPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// prospectia | manual | widget | anura | wa_mirror | (futuros)
  channel           String
  /// ID estable en sistema origen (Prospectia contact id, manual:cuid, etc.)
  externalId        String
  /// ca | ep | general
  category          String   @default("general")
  stageSlug         String   @default("por_contactar")
  /// Quién escribe etapa/ciclo: one | wa (un solo escritor; sin dual-write)
  commercialAuthority String @default("one")
  advisorEmail      String?
  /// Etiqueta comercial Prospectia (venta_exitosa_arte, mql_ep, no_contesta…) — solo lectura UI
  prospectiaStatus  String?
  /// Curso/interés (custom attr conversación o contacto)
  interestCourse    String?
  /// lead_scoring u otro score de Prospectia
  leadScore         Int?
  /// Prospectia-first: true si hay conversación Chatwoot (cualquier inbox). Independiente de mali-whatsapp.
  cameWithInbound   Boolean  @default(false)
  /// Puente opcional a ciclo mali-whatsapp (binding de canal, no segundo ciclo)
  waCycleId         Int?
  waContactId       Int?
  requiresReview    Boolean  @default(false)
  lastInteractionAt DateTime?
  closedAt          DateTime?
  sourceLabel       String?
  /// Snapshot enriquecido: contact + conversation (labels, custom_attributes, assignee, team)
  payload           Json?
  activities        EducacionCrmActivity[]
  sales             EducacionSale[]

  @@unique([channel, externalId])
  @@index([waCycleId])
  @@index([waContactId])
  @@index([cameWithInbound, closedAt])
  @@index([category, createdAt])
  @@index([advisorEmail])
  @@index([channel, createdAt])
  @@index([prospectiaStatus])
  @@index([interestCourse])
  @@index([commercialAuthority, closedAt])
  @@index([stageSlug])
}

/// Cursor / estado del poller Prospectia → ONE.
model EducacionProspectiaCursor {
  id                 String    @id @default("default")
  updatedAt          DateTime  @updatedAt
  lastPolledAt       DateTime?
  lastPage           Int       @default(0)
  lastSeenExternalId String?
  lastRunStatus      String    @default("idle") // idle | running | ok | error
  lastRunAt          DateTime?
  lastError          String?
  processedTotal     Int       @default(0)
  lastRunCreated     Int       @default(0)
  lastRunUpdated     Int       @default(0)
  lastRunSkipped     Int       @default(0)
}

/// Actividad multicanal (llamada, email, etc.). waCycleId y/o opportunityId.
model EducacionCrmActivity {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// ID del ciclo en mali-whatsapp (education_lead_cycles.id); opcional si hay opportunityId
  waCycleId     Int?
  opportunityId String?
  opportunity   EducacionOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  waContactId   Int?
  channel       String   // call | email | whatsapp | other
  direction     String   @default("outbound") // inbound | outbound
  occurredAt    DateTime
  receivedAt    DateTime @default(now())
  actorEmail    String?
  /// attempted | reached | no_answer | left_voicemail | bounced | other
  result        String
  notes         String?
  /// Payload crudo del origen (p. ej. CDR Anura completo) para armar UI sin re-fetch.
  payload       Json?
  externalRef   String?  // Anura CDR id, etc.
  externalSystem String? // anura | manual | ses

  @@index([waCycleId, occurredAt])
  @@index([opportunityId, occurredAt])
  @@index([externalSystem, externalRef])
}

/// Venta educativa (compromiso). Anclada a ciclo WA y/o oportunidad ONE.
model EducacionSale {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  waCycleId       Int?
  opportunityId   String?
  opportunity     EducacionOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  waContactId     Int?
  advisorEmail    String?
  currency        String   @default("PEN")
  amountAgreed    Decimal  @db.Decimal(12, 2)
  status          String   @default("open") // open | won | cancelled
  /// sin_verificar | parcial | pagado | revertido
  paymentStatus   String   @default("sin_verificar")
  /// pending | obs | obs_asesor | boleteado
  billingStatus   String   @default("pending")
  billingNote     String?
  enrollmentRef   String?  // SIGE u otro
  enrollmentAt    DateTime?
  buyerName       String?
  studentName     String?
  payerName       String?
  reportedTxnCode String?
  notes           String?
  items           EducacionSaleItem[]
  applications    EducacionPaymentApplication[]

  @@unique([waCycleId])
  @@unique([opportunityId])
  @@index([paymentStatus])
  @@index([billingStatus])
  @@index([reportedTxnCode])
}

model EducacionSaleItem {
  id          String        @id @default(cuid())
  saleId      String
  sale        EducacionSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  label       String
  catalogRef  String?
  amount      Decimal       @db.Decimal(12, 2)
  quantity    Int           @default(1)

  @@index([saleId])
}

/// Outbox hechos de canal (WA → ONE). Scaffolding F4; productor en WA pendiente.
model EducacionChannelEvent {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  eventId     String    @unique
  eventType   String
  occurredAt  DateTime
  receivedAt  DateTime  @default(now())
  payload     Json
  processedAt DateTime?
  error       String?

  @@index([processedAt])
  @@index([eventType, occurredAt])
}

/// Aplicación confirmada de una operación Treasury a una venta.
model EducacionPaymentApplication {
  id                String        @id @default(cuid())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  saleId            String
  sale              EducacionSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  /// niubiz | paycash | mercadopago
  provider          String
  /// ID en tabla del proveedor (TreasuryPayment.id / CIP / MP paymentId)
  providerPaymentId String
  transactionCode   String
  amountApplied     Decimal       @db.Decimal(12, 2)
  currency          String        @default("PEN")
  validatedByEmail  String
  validatedAt       DateTime      @default(now())
  reversedAt        DateTime?
  reversedByEmail   String?
  reverseReason     String?

  @@index([saleId])
  @@index([provider, providerPaymentId])
  @@index([transactionCode])
}

model ScreenCastPlaylist {
  id                String                       @id @default(cuid())
  name              String
  activo            Boolean                      @default(true)
  crossfade         Boolean                      @default(false)
  kenBurns          Boolean                      @default(false)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  items             ScreenCastPlaylistItem[]
  monitors          ScreenCastMonitor[]
  scheduleOverrides ScreenCastScheduleOverride[]
}

model ScreenCastPlaylistItem {
  id         String              @id @default(cuid())
  playlistId String
  playlist   ScreenCastPlaylist  @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  mediaUrl   String
  mediaType  ScreenCastMediaType
  durationMs Int                 @default(10000)
  sortOrder  Int                 @default(0)
  activo     Boolean             @default(true)

  @@index([playlistId, sortOrder])
}

model ScreenCastMonitor {
  id                String                       @id @default(cuid())
  screenKey         String                       @unique
  name              String
  location          String?
  photoUrl          String?
  orientation       ScreenCastOrientation        @default(LANDSCAPE)
  playlistId        String?
  playlist          ScreenCastPlaylist?          @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  lastSeenAt        DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  scheduleOverrides ScreenCastScheduleOverride[]

  @@index([playlistId])
}

model ScreenCastScheduleOverride {
  id         String             @id @default(cuid())
  monitorId  String
  playlistId String
  startsAt   DateTime
  endsAt     DateTime
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  monitor    ScreenCastMonitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  playlist   ScreenCastPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@index([monitorId, startsAt, endsAt])
  @@index([startsAt, endsAt])
}

enum NewsletterStatus {
  draft
  published
}

/// Which product surface owns / may list this newsletter row.
enum NewsletterScope {
  shared
  malichimp
  internal_communications
}

/// Library piece vs exclusive campaign working copy.
enum NewsletterKind {
  library
  campaign_working_copy
}

/// Optional visual brand for header/footer chrome in Boletines.
enum NewsletterBrand {
  museo
  cursos_arte
  extension_profesional
}

enum LandingStatus {
  draft
  published
  archived
}

enum EmailCampaignStatus {
  draft
  scheduled
  queued
  sending
  completed
  failed
}

enum EmailSendStatus {
  pending
  sent
  failed
  suppressed
}

enum EmailEventType {
  open
  click
}

enum MalichimpContactStatus {
  subscribed
  unsubscribed
  cleaned
  nonsubscribed
}

enum MalichimpSuppressionReason {
  mailchimp_unsubscribed
  mailchimp_cleaned
  malichimp_unsubscribe
  ses_bounce
  ses_complaint
  ses_unsubscribe
  manual
}

enum EmailGlobalSuppressionReason {
  bounce
  complaint
  unsubscribe
  manual
}

enum SesEventType {
  send
  rendering_failure
  reject
  delivery
  bounce
  complaint
  delivery_delay
  subscription
  open
  click
}

model Newsletter {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  subject     String
  htmlBody    String           @db.Text
  /// GrapesJS project JSON for re-editing the visual design.
  designJson  String?          @db.Text
  /// Optional brand selects the matching header + footer chrome.
  brand       NewsletterBrand?
  status      NewsletterStatus @default(draft)
  scope       NewsletterScope  @default(shared)
  kind        NewsletterKind   @default(library)
  /// Library piece this working copy was forked from (optional).
  sourceNewsletterId String?
  sourceNewsletter   Newsletter?  @relation("NewsletterSource", fields: [sourceNewsletterId], references: [id], onDelete: SetNull)
  derivedNewsletters Newsletter[] @relation("NewsletterSource")
  /// Bumps on each content edit; used for optimistic send/test checks.
  contentRevision Int          @default(1)
  createdById String
  createdBy   User             @relation(fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  /// Campaigns that treat this row as library base (audit / provenance).
  campaigns   EmailCampaign[]  @relation("CampaignLibraryNewsletter")
  /// At most one campaign may own this row as exclusive working copy.
  workingForCampaign EmailCampaign? @relation("CampaignWorkingNewsletter")

  @@index([createdById])
  @@index([status])
  @@index([brand])
  @@index([scope, kind])
  @@index([sourceNewsletterId])
}

model LandingPage {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  status           LandingStatus @default(draft)
  content          Json
  seoTitle         String?
  seoDescription   String?
  focusKeyphrase   String?
  ogImageUrl       String?
  publishedHtml    String?       @db.Text
  publishedVersion Int           @default(0)
  publishedAt      DateTime?
  createdById      String?
  createdBy        User?         @relation("LandingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById      String?
  updatedBy        User?         @relation("LandingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, updatedAt])
  @@index([createdById])
  @@index([updatedById])
}

model EmailCampaign {
  id                      String              @id @default(cuid())
  /// Library base (provenance). Never edited from audience modules as send source.
  newsletterId            String
  newsletter              Newsletter          @relation("CampaignLibraryNewsletter", fields: [newsletterId], references: [id], onDelete: Restrict)
  /// Exclusive working copy for draft edit/preview/test/snapshot. Unique across campaigns.
  workingNewsletterId     String?             @unique
  workingNewsletter       Newsletter?         @relation("CampaignWorkingNewsletter", fields: [workingNewsletterId], references: [id], onDelete: Restrict)
  name                    String
  replyToEmail            String?
  /// Immutable content captured when the campaign is sent/queued.
  subjectSnapshot         String              @db.VarChar(300)
  htmlSnapshot            String              @db.Text
  designJsonSnapshot      String?             @db.Text
  brandSnapshot           NewsletterBrand?
  fromName                String?             @db.VarChar(160)
  fromEmail               String?             @db.VarChar(320)
  /// Optional public route owned by the audience module, without coupling the dispatcher to it.
  unsubscribePath         String?             @db.VarChar(200)
  /// Explicit opt-in prevents legacy campaigns from being picked up by the shared dispatcher.
  managedByDispatcher     Boolean             @default(false)
  status                  EmailCampaignStatus @default(draft)
  audienceArea            String              @default("pam")
  /// Legacy singular; prefer audienceSegments.
  audienceSegment         String?
  audienceSegments        String[]            @default([])
  audienceExcludeSegments String[]            @default([])
  audienceIncludeContactIds String[]          @default([])
  audienceExcludeContactIds String[]          @default([])
  audienceAttrKey         String?
  audienceAttrValue       String?
  totalRecipients         Int                 @default(0)
  sentCount               Int                 @default(0)
  openCount               Int                 @default(0)
  clickCount              Int                 @default(0)
  errorCount              Int                 @default(0)
  scheduledAt             DateTime?
  startedAt               DateTime?
  completedAt             DateTime?
  createdById             String
  createdBy               User                @relation(fields: [createdById], references: [id])
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  sends                   EmailSend[]
  events                  EmailEvent[]

  @@index([newsletterId])
  @@index([createdById])
  @@index([status])
  @@index([scheduledAt])
}

/// Sender addresses offered to business modules. SES identity verification remains in AWS.
model EmailSender {
  id          String   @id @default(cuid())
  email       String   @unique @db.VarChar(320)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
}

model EmailSend {
  id              String          @id @default(cuid())
  campaignId      String
  campaign        EmailCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email           String
  contactId       Int?
  /// Identifier in the audience module; intentionally has no cross-module foreign key.
  sourceContactId String?         @db.VarChar(120)
  name            String?
  status          EmailSendStatus @default(pending)
  openToken       String          @unique @default(cuid())
  sesMessageId    String?
  error           String?
  attemptCount    Int             @default(0)
  claimedAt       DateTime?
  nextAttemptAt   DateTime?
  sentAt          DateTime?
  deliveredAt     DateTime?
  bouncedAt       DateTime?
  complainedAt    DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  repliedAt       DateTime?
  isTest          Boolean         @default(false)
  createdAt       DateTime        @default(now())
  events          EmailEvent[]

  @@index([campaignId])
  @@index([email])
  @@index([status, nextAttemptAt])
  @@index([sesMessageId])
  @@index([repliedAt])
  @@index([campaignId, isTest])
}

model EmailEvent {
  id         String         @id @default(cuid())
  campaignId String
  campaign   EmailCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sendId     String?
  send       EmailSend?     @relation(fields: [sendId], references: [id], onDelete: SetNull)
  type       EmailEventType
  url        String?
  userAgent  String?
  createdAt  DateTime       @default(now())

  @@index([campaignId, createdAt])
  @@index([sendId])
  @@index([type])
}

/// Contact database imported from Mailchimp. It remains independent from the WhatsApp CRM.
model MalichimpContact {
  id              String                        @id @default(cuid())
  email           String                        @unique @db.VarChar(320)
  firstName       String?                       @db.VarChar(160)
  lastName        String?                       @db.VarChar(160)
  phone           String?                       @db.VarChar(80)
  institutionName String?                       @db.VarChar(300)
  jobTitle        String?                       @db.VarChar(200)
  city            String?                       @db.VarChar(160)
  country         String?                       @db.VarChar(120)
  classification  String?                       @db.VarChar(160)
  source          String?                       @db.VarChar(240)
  status          MalichimpContactStatus
  optInAt         DateTime?
  confirmedAt     DateTime?
  statusChangedAt DateTime?
  /// Sparse segmentation fields retained without creating dozens of mostly empty columns.
  attributes      Json?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  tags            MalichimpContactTag[]
  groupOptions    MalichimpContactGroupOption[]

  @@index([status])
  @@index([lastName, firstName])
  @@index([updatedAt])
}

model MalichimpTag {
  id             String                @id @default(cuid())
  name           String                @db.VarChar(200)
  normalizedName String                @unique @db.VarChar(200)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  contacts       MalichimpContactTag[]

  @@index([name])
}

model MalichimpContactTag {
  contactId String
  tagId     String
  contact   MalichimpContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       MalichimpTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@id([contactId, tagId])
  @@index([tagId])
}

/// A Mailchimp group category (for example, "Dirección y Gerencia").
model MalichimpGroup {
  id             String                 @id @default(cuid())
  name           String                 @db.VarChar(200)
  normalizedName String                 @unique @db.VarChar(200)
  sortOrder      Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  options        MalichimpGroupOption[]

  @@index([sortOrder, name])
}

/// A selectable option inside a Mailchimp group category (for example, "Consejo").
model MalichimpGroupOption {
  id             String                        @id @default(cuid())
  groupId        String
  group          MalichimpGroup                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name           String                        @db.VarChar(200)
  normalizedName String                        @db.VarChar(200)
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  contacts       MalichimpContactGroupOption[]

  @@unique([groupId, normalizedName])
  @@index([groupId, name])
}

model MalichimpContactGroupOption {
  contactId String
  optionId  String
  contact   MalichimpContact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  option    MalichimpGroupOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  createdAt DateTime             @default(now())

  @@id([contactId, optionId])
  @@index([optionId])
}

/// Addresses that must never receive a campaign, regardless of segment membership.
model MalichimpSuppression {
  id         String                     @id @default(cuid())
  email      String                     @unique @db.VarChar(320)
  reason     MalichimpSuppressionReason
  source     String                     @db.VarChar(80)
  occurredAt DateTime?
  metadata   Json?
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  @@index([reason])
  @@index([updatedAt])
}

/// Provider-level safety list shared by every email-producing module.
/// Business opt-outs remain in their owning audience module.
model EmailGlobalSuppression {
  id         String                       @id @default(cuid())
  email      String                       @unique @db.VarChar(320)
  reason     EmailGlobalSuppressionReason
  source     String                       @db.VarChar(80)
  occurredAt DateTime?
  metadata   Json?
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt

  @@index([reason])
  @@index([updatedAt])
}

model MalichimpImportRun {
  id              String    @id @default(cuid())
  sourceKey       String    @db.VarChar(160)
  sourceDirectory String    @db.VarChar(500)
  fileFingerprint String    @db.VarChar(64)
  counts          Json
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([sourceKey, startedAt])
  @@index([fileFingerprint])
}

model MalichimpImportJob {
  id           String    @id @default(cuid())
  userId       String
  status       String    @db.VarChar(20)
  originalName String    @db.VarChar(240)
  processed    Int       @default(0)
  total        Int
  runId        String?
  error        String?   @db.VarChar(1000)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([status])
  @@index([userId, startedAt])
}

/// Immutable, idempotent record of an SES event received through EventBridge/SQS.
/// It belongs to the shared email engine, not to a specific CRM module.
model SesEventRecord {
  id         String       @id @default(cuid())
  eventKey   String       @unique @db.VarChar(500)
  eventId    String       @db.VarChar(120)
  messageId  String?      @db.VarChar(255)
  type       SesEventType
  email      String?      @db.VarChar(320)
  occurredAt DateTime
  payload    Json
  createdAt  DateTime     @default(now())

  @@index([messageId])
  @@index([eventId])
  @@index([email, occurredAt])
  @@index([type, occurredAt])
}

model TodoType {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String?
  active    Boolean    @default(true)
  sortOrder Int        @default(0)
  todos     TodoItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model TodoStatus {
  id        String     @id @default(cuid())
  key       String     @unique
  name      String
  color     String?
  isDone    Boolean    @default(false)
  sortOrder Int        @default(0)
  todos     TodoItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model PortfolioProjectStatus {
  id        String             @id @default(cuid())
  key       String             @unique
  name      String
  color     String?
  isClosed  Boolean            @default(false)
  sortOrder Int                @default(0)
  projects  PortfolioProject[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model PortfolioProject {
  id          String                 @id @default(cuid())
  name        String
  detail      String?                @db.Text
  statusId    String
  status      PortfolioProjectStatus @relation(fields: [statusId], references: [id])
  area        PortfolioArea          @default(otros)
  projectType PortfolioProjectType   @default(otro)
  stakeholder String?
  impact      PortfolioImpact        @default(medium)
  link        String?
  targetAt    DateTime?
  ownerId     String
  owner       User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sortOrder   Int                    @default(0)
  archivedAt  DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  tasks       TodoItem[]

  @@index([ownerId])
  @@index([statusId])
  @@index([area])
  @@index([projectType])
  @@index([ownerId, statusId])
  @@index([ownerId, archivedAt])
  @@index([targetAt])
}

model TodoItem {
  id               String            @id @default(cuid())
  title            String
  detail           String?           @db.Text
  typeId           String?
  type             TodoType?         @relation(fields: [typeId], references: [id], onDelete: SetNull)
  priority         TodoPriority      @default(medium)
  effort           TodoEffort?
  statusId         String
  status           TodoStatus        @relation(fields: [statusId], references: [id])
  ownerId          String
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projectId        String?
  project          PortfolioProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  area             PortfolioArea?
  origin           TodoOrigin        @default(internal)
  impact           PortfolioImpact   @default(medium)
  link             String?
  registeredAt     DateTime          @default(now())
  dueAt            DateTime?
  scheduledAt      DateTime?
  statusChangedAt  DateTime          @default(now())
  completedAt      DateTime?
  archivedAt       DateTime?
  sortOrder        Int               @default(0)
  timeSpentMinutes Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([ownerId])
  @@index([statusId])
  @@index([dueAt])
  @@index([scheduledAt])
  @@index([typeId])
  @@index([projectId])
  @@index([area])
  @@index([origin])
  @@index([ownerId, statusId])
  @@index([ownerId, dueAt])
  @@index([ownerId, archivedAt])
}

model OperationalService {
  id        String                   @id @default(cuid())
  name      String
  status    OperationalServiceStatus @default(up)
  notes     String?                  @db.Text
  sortOrder Int                      @default(0)
  ownerId   String
  owner     User                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([ownerId, sortOrder])
}
